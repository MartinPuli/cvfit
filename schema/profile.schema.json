{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cv-converter profile",
  "description": "Canonical CV data, one file per person, JSON or YAML. Leave out any section the person does not have; an empty section is dropped at render time and never invented. The model tailors a copy of this per application; the builder renders it.",
  "type": "object",
  "required": [
    "name",
    "contact",
    "sections"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "contact": {
      "type": "array",
      "description": "Rendered centred under the name, joined by pipes. Plain text, no protocol prefixes.",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "heading",
          "entries"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "description": "Rendered upper-case. Harvard order: Education, Experience, Leadership & Activities, Skills & Interests."
          },
          "priority": {
            "type": "integer",
            "default": 50,
            "description": "Higher survives auto-fit. Sections are never dropped, only their entries."
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "subtitle": {
                  "type": "string",
                  "default": ""
                },
                "meta": {
                  "type": "string",
                  "default": "",
                  "description": "Right side of the second line, usually location."
                },
                "date": {
                  "type": "string",
                  "default": ""
                },
                "text": {
                  "type": "string",
                  "default": "",
                  "description": "Prose alternative to bullets."
                },
                "priority": {
                  "type": "integer",
                  "default": 50
                },
                "bullets": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "required": [
                          "text"
                        ],
                        "properties": {
                          "text": {
                            "type": "string"
                          },
                          "priority": {
                            "type": "integer",
                            "default": 50
                          }
                        }
                      }
                    ]
                  }
                },
                "items": {
                  "type": "array",
                  "description": "Labelled lines, for a skills block: rendered as `Label: text` with the label bold. Use instead of bullets when the entry has no title.",
                  "items": {
                    "type": "object",
                    "required": [
                      "label",
                      "text"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "Two or three lines under the contact block. Rendered only when the kind asks for it (job does, hackathon and competition do not). Rewrite it per posting."
    },
    "style": {
      "type": "object",
      "description": "Typography defaults. Command-line flags still win.",
      "properties": {
        "font": {
          "type": "string",
          "description": "Comma-separated fallback chain"
        },
        "size": {
          "type": "string"
        },
        "margin": {
          "type": "string"
        }
      }
    }
  }
}
